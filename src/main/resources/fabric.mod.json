{
  "schemaVersion": 1,
  "id": "hardwarescaler",
  "version": "${version}",
  "name": "Hardware Scaler",
  "description": "Detects system hardware and applies tiered performance presets, plus an upload-based jukebox with short song codes (/song <code>).",
  "authors": [
    "arzmods"
  ],
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.example.hardwarescaler.HardwareScalerClient"
    ],
    "main": [
      "com.example.jukeboxhits.fabric.JukeboxFabric"
    ],
    "voicechat": [
      "com.example.jukeboxhits.core.play.JukeboxVoicechatPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "*",
    "java": ">=${java_version}",
    "voicechat": ">=2.5.0"
  }
}
