{
  "schemaVersion": 1,
  "id": "soundboardmc",
  "version": "${version}",
  "name": "SoundboardMC",
  "description": "Play songs from your computer into Simple Voice Chat, so you and everyone near you hear them. Press J.",
  "authors": [
    "arzmods"
  ],
  "icon": "assets/soundboardmc/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.soundboard.fabric.SoundboardFabric"
    ],
    "voicechat": [
      "com.example.soundboard.SoundboardPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "*",
    "java": ">=${java_version}",
    "voicechat": "*",
    "voicechat_api": ">=2.5.0"
  }
}
