{
  "schemaVersion": 1,
  "id": "hardwarescaler",
  "version": "${version}",
  "name": "Hardware Scaler",
  "description": "Detects system hardware and applies tiered performance presets, plus a soundboard that plays songs into your Simple Voice Chat microphone (press J).",
  "authors": [
    "arzmods"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.hardwarescaler.HardwareScalerClient",
      "com.example.soundboard.SoundboardClient"
    ],
    "voicechat": [
      "com.example.soundboard.SoundboardPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "*",
    "java": ">=${java_version}",
    "voicechat": "*",
    "voicechat_api": ">=2.5.0"
  }
}
